{
  "schemaVersion": 1,
  "id": "io.github.aayush9029.omaai",
  "name": "OmaAI",
  "version": "0.1.1",
  "author": "Aayush Pokharel",
  "license": "MIT",
  "description": "Control a local llama.cpp model from the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "omarchy/Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaAI",
    "description": "Control a local llama.cpp model from the Omarchy bar.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "command": "omaai",
      "refreshIntervalMs": 3000
    },
    "schema": [
      {
        "key": "refreshIntervalMs",
        "type": "integer",
        "label": "Refresh interval (milliseconds)",
        "min": 1000,
        "max": 30000,
        "step": 1000,
        "defaultValue": 3000
      }
    ]
  }
}
