#!/usr/bin/env bash
set -euo pipefail

config_path="${HOME}/.config/omaai/env"
[[ -r "${config_path}" ]] || { echo "Missing ${config_path}" >&2; exit 1; }

set -a
source "${config_path}"
set +a

exec "${OMAAI_LLAMA_SERVER}" \
  --model "${OMAAI_MODEL}" \
  --host "${OMAAI_HOST:-127.0.0.1}" \
  --port "${OMAAI_PORT:-8080}" \
  --api-key-file "${OMAAI_API_KEY_FILE}" \
  --alias omaai \
  --n-gpu-layers 999 \
  --ctx-size "${OMAAI_CONTEXT:-32768}" \
  --parallel 1 \
  --flash-attn on \
  --jinja \
  --chat-template-kwargs '{"enable_thinking":false}' \
  --cache-prompt
